# Free local mode. No API key is required.
BOOKMOTH_PROVIDER=ollama
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5vl:7b
OLLAMA_NUM_CTX=32768
OLLAMA_NUM_PREDICT=6144
OLLAMA_TIMEOUT_MS=300000
OLLAMA_KEEP_ALIVE=5m

# Optional paid cloud mode. Set BOOKMOTH_PROVIDER=openai and keep this secret
# on the server. Never commit a real key or expose it in browser code.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
