# Free local mode. No API key is required.
BOOKMOTH_PROVIDER=ollama
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5vl:7b
# The vision model reads images. The teaching model drafts and reviews detailed lessons.
OLLAMA_TEACHING_MODEL=qwen3.5:9b
OLLAMA_NUM_CTX=32768
OLLAMA_NUM_PREDICT=6144
OLLAMA_TEACHING_NUM_CTX=32768
OLLAMA_TEACHING_NUM_PREDICT=6144
OLLAMA_REVIEW_NUM_PREDICT=2048
OLLAMA_TIMEOUT_MS=300000
OLLAMA_KEEP_ALIVE=5m

# Optional direct OpenAI mode. Keep the key on the server. Never commit a real
# key or expose it in browser code.
# BOOKMOTH_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Vercel hosting can use AI Gateway OIDC instead of OPENAI_API_KEY. Vercel
# supplies VERCEL_OIDC_TOKEN automatically at runtime.
# OPENAI_BASE_URL=https://ai-gateway.vercel.sh/v1
# OPENAI_MODEL=openai/gpt-5-mini
# AI_GATEWAY_CREDITS_READY=true
